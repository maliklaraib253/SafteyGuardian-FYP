rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPolice() {
      return isAuthenticated() && request.auth.token.email.matches('.*@police\\.gov\\.pk$');
    }

    // Users collection (read allowed so registration pre-check can verify email/CNIC availability)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Private Identity Subcollection:
      // Stores biometric reference embeddings and CNIC verification records.
      // STRICTLY restricted to the owning user UID. Other users cannot read/write this.
      match /identity/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Incident Reports collection
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      
      // Enforce that report creator is logged in, submitting under their own UID,
      // and has identityVerified asserted.
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.identityVerified == true;

      // Only the report author or police can modify or manage reports
      allow update, delete: if isOwner(resource.data.userId) || isPolice();
    }

    // Emergency Contacts collection
    match /contacts/{contactId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // SOS events collection
    match /sos_events/{eventId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isPolice());
    }

    // Companion Mode live tracking sessions
    match /companion_sessions/{sessionId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isPolice());
    }
  }
}
