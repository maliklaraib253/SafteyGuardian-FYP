rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Police = a @police.gov.pk email that an admin has approved (document
    // police_officers/{email}, created from the admin portal).
    // (Just owning an address that ends in @police.gov.pk is not enough.)
    function isPolice() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@police[.]gov[.]pk$')
        && exists(/databases/$(database)/documents/police_officers/$(request.auth.token.email.lower()));
    }

    // Admin = an account listed in admins/{email} (lower case). The first
    // admin is added once in the Firebase console.
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // A citizen blocked by an admin (users/{uid}.blocked == true).
    function isBlocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    // Fields only an admin may set on a user profile.
    function touchesBlockFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['blocked', 'blockedReason', 'blockedAt', 'blockedBy']);
    }

    // Fields only an admin may set on a report.
    function touchesModerationFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['moderation', 'moderationReason', 'moderatedBy', 'moderatedAt']);
    }

    // Fields only police may change on a report.
    function touchesPoliceFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'policeRemarks', 'remarksBy', 'remarksAt',
                 'statusHistory', 'resolvedAt', 'userId',
                 'assignedTo', 'assignedAt']);
    }

    // Admin accounts. Added in the Firebase console only.
    match /admins/{email} {
      allow get: if isAuthenticated() && request.auth.token.email != null && myEmail() == email;
      allow list: if isAdmin();
      allow write: if false;
    }

    // Approved officers. Managed from the admin portal.
    match /police_officers/{email} {
      allow get: if (isAuthenticated() && request.auth.token.email != null && myEmail() == email)
                 || isAdmin();
      allow list: if isAdmin() || isPolice();
      allow write: if isAdmin();
    }

    // Access requests from unapproved @police.gov.pk accounts.
    match /police_requests/{email} {
      allow get: if (isAuthenticated() && request.auth.token.email != null && myEmail() == email)
                 || isAdmin();
      allow list: if isAdmin();
      allow create, update: if (isAuthenticated()
                                && request.auth.token.email != null
                                && myEmail() == email
                                && request.resource.data.uid == request.auth.uid
                                && request.resource.data.status == 'pending')
                            || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin activity log: append-only, readable by admins.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == myEmail();
      allow update, delete: if false;
    }

    // Content published from the admin portal (e.g. Legal Hub guides/videos).
    match /app_content/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profiles (name, CNIC, face data): only the owner, police and admins.
    // Signup's "already registered?" check uses /registry instead.
    match /users/{userId} {
      allow read: if isOwner(userId) || isPolice() || isAdmin();
      allow create: if isOwner(userId) && !('blocked' in request.resource.data);
      // Owners edit their profile but never their own block status.
      allow update: if (isOwner(userId) && !touchesBlockFields()) || isAdmin();
      // Admins can delete a profile (Admin Portal: "Delete account data").
      allow delete: if isAdmin();

      // Private Identity Subcollection:
      // Stores biometric reference embeddings and CNIC verification records.
      // STRICTLY restricted to the owning user UID. Other users cannot read/write this.
      match /identity/{docId} {
        allow read, write: if isOwner(userId);
        allow read, delete: if isAdmin();
      }
    }

    // Incident Reports collection
    match /reports/{reportId} {
      // Only the person who reported it, police or admins can read a report.
      allow read: if isOwner(resource.data.userId) || isPolice() || isAdmin();

      // Creator must be logged in, submit under their own UID and be
      // identity-verified. Anonymous reports must not carry the reporter's
      // email or verification selfie (those go to report_identity instead).
      allow create: if isAuthenticated()
                    && !isBlocked()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.identityVerified == true
                    && request.resource.data.get('status', 'pending') == 'pending'
                    && (request.resource.data.get('isAnonymous', false) != true
                        || (!('userEmail' in request.resource.data)
                            && !('verificationSelfieUrl' in request.resource.data)));

      // Police manage status and remarks; the reporter may only update
      // their own report's details (e.g. AI analysis), not its status.
      // Admins moderate (fake/spam flags, reassignment); police cannot
      // change moderation flags.
      // A report an admin flagged as fake/spam is read-only for police until
      // an admin clears the flag.
      allow update: if isAdmin()
                    || (isPolice() && !touchesModerationFields()
                        && resource.data.get('moderation', '') == '')
                    || (isOwner(resource.data.userId) && !isBlocked()
                        && !touchesPoliceFields() && !touchesModerationFields());
      allow delete: if isOwner(resource.data.userId) || isPolice() || isAdmin();
    }

    // Identity behind anonymous reports. Write-once by the reporter. Police
    // can never read it; an admin can look one up from the portal (with a
    // reason that is written to the activity log), e.g. for a malicious report.
    match /report_identity/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow get: if isAdmin();
      allow list, update: if false;
      allow delete: if isAdmin();
    }

    // Signup registry: one-way hashes of emails / CNICs -> owner uid.
    // A direct get is allowed (also before login, for the signup check);
    // listing is not, so nobody can browse it.
    match /registry/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if (isAuthenticated() && resource.data.uid == request.auth.uid)
                    || isAdmin();
    }

    // Companion Mode live tracking sessions
    match /companion_sessions/{sessionId} {
      // Trips are private: only the traveller. Trusted contacts follow the
      // trip through SMS links; police get no trip data (only SOS calls 15).
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && !isBlocked() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
