rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Same checks as firestore.rules (reads the Firestore documents).
    function isPolice() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('.*@police[.]gov[.]pk$')
        && firestore.exists(/databases/(default)/documents/police_officers/$(request.auth.token.email.lower()));
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isImageUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Biometric and CNIC identity pictures: only the owner.
    match /users/{userId}/identity/{allPaths=**} {
      allow read, write: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Report evidence and verification selfies. Not public: only the
    // reporter, approved police and admins can download them. Nobody can
    // list the folder.
    match /reports/{userId}/{allPaths=**} {
      allow get: if isOwner(userId) || isPolice() || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && isImageUnder10MB();
      allow update: if false;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
